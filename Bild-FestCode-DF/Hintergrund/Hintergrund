using System;
using System.IO;
using System.Diagnostics;
using System.Threading.Tasks;

namespace NWOS.Bootstrap.Windows
{
    public class SystemBootstrapper
    {
        private const string BackgroundExe =
        @"C:\NWOS\NWOS\Bilder-NWOS\Hintergrund-Wasserzeichen\NWOS-Logo-Standart Hintergund.png";

        public async Task InitializeSystemAsync()
    {
        bool isSystemBooting = true;

        if (isSystemBooting)
        {
            // 1. Alya und Kerndienste starten
            await RunAlyaMaintenanceProtocolAsync();
        }

        // 2. Auf Benutzer-Login warten
        bool loginAccessGranted = await WaitForUserLoginAsync();

        if (loginAccessGranted)
        {
            // 3. Hintergrundbild setzen
            await TriggerStartupBackgroundAsync();

            // 4. Desktop-Startup-Protokoll
            GiveStartupProtocol();
        }
    }

        private async Task TriggerStartupBackgroundAsync()
    {
        try
        {
            if (!File.Exists(BackgroundExe))
            {
                Console.WriteLine(
                        "NWOS ERROR: Hintergrund.exe wurde nicht gefunden!");

                return;
            }

            ProcessStartInfo startInfo = new ProcessStartInfo
            {
                FileName = BackgroundExe,
                        WorkingDirectory = Path.GetDirectoryName(BackgroundExe),
                        UseShellExecute = true
            };

            using Process process = Process.Start(startInfo);

            if (process == null)
            {
                Console.WriteLine(
                        "NWOS ERROR: Hintergrundprozess konnte nicht gestartet werden.");

                return;
            }

            await process.WaitForExitAsync();

            if (process.ExitCode == 0)
            {
                Console.WriteLine(
                        "NWOS: Hintergrundbild erfolgreich verarbeitet.");
            }
            else
            {
                Console.WriteLine(
                        $"NWOS ERROR: Hintergrundprozess beendet mit Code {process.ExitCode}.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                    $"NWOS BACKGROUND ERROR: {ex.Message}");
        }
    }

        private async Task RunAlyaMaintenanceProtocolAsync()
    {
        await Task.Delay(2000);
    }

        private async Task<bool> WaitForUserLoginAsync()
    {
        return await Task.FromResult(true);
    }

        private void GiveStartupProtocol()
        {
            Console.WriteLine(
                    "Startup-Protokoll erfolgreich ausgeführt. Willkommen in NWOS!");
        }
    }
}