<UserControl x:Class="NWOS.DesktopShell.Ui.Button.MasterFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:NWOS.DesktopShell.Ui;assembly=NWOS.ConfigSetup"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Width="64"
             Height="45"
             d:DesignWidth="64"
             d:DesignHeight="45">
    <Grid>
        <ToggleButton x:Name="MasterToggleButton"
                      Width="64"
                      Height="45"
                      Padding="0"
                      Background="Transparent"
                      BorderThickness="0"
                      Cursor="Hand"
                      ToolTip="NWOS-Startmenü"
                      Click="MasterToggleButton_Click">
            <Image Source="/NWOS.DesktopShell.Ui;component/Assets/MasterButton/Button Logo.jpeg"
                   Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </ToggleButton>

        <Popup x:Name="MasterPopup"
               Placement="Top"
               PlacementTarget="{Binding ElementName=MasterToggleButton}"
               VerticalOffset="-8"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="None"
               Opened="MasterPopup_Opened"
               Closed="MasterPopup_Closed">
            <Grid x:Name="PopupRoot"
                  Width="560"
                  MaxHeight="760"
                  ClipToBounds="True"
                  PreviewKeyDown="PopupRoot_PreviewKeyDown">
                <Border x:Name="MenuPanel"
                        Width="560"
                        MaxHeight="760"
                        Background="#E6192335"
                        BorderBrush="#806AADE4"
                        BorderThickness="1"
                        CornerRadius="16"
                        Opacity="1"
                        RenderTransformOrigin="0.5,1">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="MenuTransform" />
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="MenuColumn" Width="560" />
                            <ColumnDefinition x:Name="SettingsColumn" Width="0" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="MenuBackgroundImage"
                               Grid.ColumnSpan="2"
                               Source="/NWOS.DesktopShell.Ui;component/Assets/MasterButton/Master-Background.jpeg"
                               Stretch="UniformToFill"
                               Opacity="0.32"
                               IsHitTestVisible="False" />
                        <ScrollViewer x:Name="MenuScrollViewer"
                                      Grid.Column="0"
                                      Width="560"
                                      MaxHeight="760"
                                      Padding="20,18"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid Margin="2,0,2,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="NWOS"
                                               Foreground="#EAF5FF"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Alle"
                                               Grid.Column="1"
                                               Foreground="#D5E8FA"
                                               FontSize="13"
                                               VerticalAlignment="Center" />
                                    <Image x:Name="FortressImage"
                                           Source="/NWOS.DesktopShell.Ui;component/Assets/MasterButton/Flyout-Festung.jpeg"
                                           Width="76"
                                           Height="52"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Stretch="Uniform"
                                           IsHitTestVisible="False" />
                                </Grid>

                                <StackPanel Margin="0,0,0,14">
                                    <DockPanel>
                                        <Button Content="Suchen"
                                                DockPanel.Dock="Right"
                                                Click="Search_Click"
                                                Style="{StaticResource TaskbarButtonStyle}" />
                                        <Grid Margin="0,0,8,0">
                                            <TextBox x:Name="MasterSearchBox"
                                                     Height="38"
                                                     Padding="12,6"
                                                     VerticalContentAlignment="Center"
                                                     Background="#D91A2D43"
                                                     Foreground="#F3F4F6"
                                                     CaretBrush="#38BDF8"
                                                     BorderBrush="#7089A6"
                                                     TextChanged="MasterSearchBox_TextChanged"
                                                     KeyDown="MasterSearchBox_KeyDown"
                                                     ToolTip="Apps und NWOS durchsuchen" />
                                            <TextBlock Text="Nach Apps und Einstellungen suchen"
                                                       Margin="13,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="#AABBD0"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=MasterSearchBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DockPanel>

                                    <Border x:Name="CommandHelpPanel"
                                            Visibility="Collapsed"
                                            Margin="0,8,0,0"
                                            Padding="10,8"
                                            Background="#F0192434"
                                            BorderBrush="#506AADE4"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="Befehle"
                                                       Foreground="#EAF5FF"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,5" />
                                            <TextBlock Text="/help  —  Befehlsübersicht&#x0a;/admin access &lt;code&gt;  —  Funktionskanal öffnen&#x0a;Cardinal: /workspace auto · /review &lt;ID&gt; · ANWENDEN &lt;ID&gt;"
                                                       Foreground="#C5D5E8"
                                                       FontSize="11"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="CommandHelpStatus"
                                                       Foreground="#FCA5A5"
                                                       FontSize="10"
                                                       Margin="0,5,0,0"
                                                       TextWrapping="Wrap"
                                                       Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="PinnedActionsPanel" Margin="0,0,0,12">
                                    <TextBlock Text="Angeheftet"
                                               Foreground="#EAF5FF"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="2,0,2,8" />
                                    <UniformGrid Columns="2">
                                        <Button Content="⚙  Windows-Einstellungen"
                                                Height="62"
                                                Margin="4"
                                                Click="PcSettings_Click"
                                                Style="{StaticResource TaskbarButtonStyle}" />
                                        <Button Content="✦  NWOS-Einstellungen"
                                                Height="62"
                                                Margin="4"
                                                Click="NwosSettings_Click"
                                                Style="{StaticResource TaskbarButtonStyle}" />
                                        <Button Content="🔋  Energieeinstellungen"
                                                Height="62"
                                                Margin="4"
                                                Click="PowerSettings_Click"
                                                Style="{StaticResource TaskbarButtonStyle}" />
                                        <Button Content="⏻  NWOS herunterfahren"
                                                Height="62"
                                                Margin="4"
                                                Click="ExitToWindows_Click"
                                                Style="{StaticResource TaskbarButtonStyle}" />
                                    </UniformGrid>
                                </StackPanel>

                                <Border x:Name="CardinalAdminConsolePanel"
                                        Visibility="Collapsed"
                                        Margin="0,4,0,12"
                                        Padding="10"
                                        Background="#E6141821"
                                        BorderBrush="#2E3A52"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="CARDINAL // FUNKTIONSKANAL"
                                                       Foreground="#60A5FA"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="ConsoleChatTargetTextBlock"
                                                       Text="Befehle oder /call Alya|Alice|Cardinal"
                                                       DockPanel.Dock="Right"
                                                       Foreground="#9CA3AF"
                                                       FontSize="10"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>

                                        <Border Background="#0D1017"
                                                BorderBrush="#1F2937"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8">
                                            <ScrollViewer x:Name="CardinalConsoleScrollViewer"
                                                          Height="220"
                                                          VerticalScrollBarVisibility="Auto">
                                                <ItemsControl x:Name="CardinalConsoleMessagesControl">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,6"
                                                                    Padding="7,5"
                                                                    Background="#181E2A"
                                                                    CornerRadius="5">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Sender}"
                                                                               Foreground="#93C5FD"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Message}"
                                                                               Foreground="#F3F4F6"
                                                                               FontSize="11"
                                                                               TextWrapping="Wrap"
                                                                               Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="CardinalCommandInputBox"
                                                     Grid.Column="0"
                                                     Padding="7,5"
                                                     FontSize="11"
                                                     Background="#1B2230"
                                                     Foreground="#F9FAFB"
                                                     CaretBrush="#60A5FA"
                                                     BorderBrush="#334155"
                                                     KeyDown="CardinalCommandInputBox_KeyDown"
                                                     ToolTip="Chat-Nachricht senden oder Befehl: status, events, scan, hide" />
                                            <Button Grid.Column="1"
                                                    Content="Ausführen"
                                                    Margin="6,0,0,0"
                                                    Padding="10,5"
                                                    FontSize="11"
                                                    Click="SendCardinalCommand_Click"
                                                    Style="{StaticResource TaskbarButtonStyle}" />
                                        </Grid>

                                        <UniformGrid Columns="4" Margin="0,6,0,0">
                                            <Button Content="Status" Tag="status" Margin="2"
                                                    Click="ConsoleQuickAction_Click"
                                                    Style="{StaticResource TaskbarButtonStyle}" />
                                            <Button Content="Ereignisse" Tag="events" Margin="2"
                                                    Click="ConsoleQuickAction_Click"
                                                    Style="{StaticResource TaskbarButtonStyle}" />
                                            <Button Content="Scan" Tag="scan" Margin="2"
                                                    Click="ConsoleQuickAction_Click"
                                                    Style="{StaticResource TaskbarButtonStyle}" />
                                            <Button Content="Schließen" Tag="hide" Margin="2"
                                                    Click="ConsoleQuickAction_Click"
                                                    Style="{StaticResource TaskbarButtonStyle}" />
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <Separator Margin="2,0,2,10" />
                                <UniformGrid Columns="2">
                                    <Button Content="↻  Neu starten"
                                            Height="54"
                                            Margin="4"
                                            Click="Restart_Click"
                                            Style="{StaticResource TaskbarButtonStyle}" />
                                    <Button Content="⏻  Herunterfahren"
                                            Height="54"
                                            Margin="4"
                                            Click="Shutdown_Click"
                                            Style="{StaticResource TaskbarButtonStyle}" />
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                        <Border x:Name="SettingsPanelHost"
                                Grid.Column="1"
                                Visibility="Collapsed"
                                Background="#F0192434"
                                BorderBrush="#506AADE4"
                                BorderThickness="1,0,0,0">
                            <settings:NwosSettingsPanel x:Name="NwosSettingsPanel" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</UserControl>
