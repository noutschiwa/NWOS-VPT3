<UserControl x:Class="NWOS.DesktopShell.Ui.Button.WorkspaceFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="45" d:DesignWidth="55">

    <Grid x:Name="WorkspaceContainer">
        <!-- Taskleisten-Button -->
        <ToggleButton x:Name="WorkspaceToggleButton"
                      Content="WS"
                      Padding="8,0"
                      Height="36"
                      Background="Transparent"
                      Foreground="#F3F4F6"
                      FontWeight="SemiBold"
                      BorderThickness="0"
                      Cursor="Hand" />

        <!-- Workspace-Switcher Popup -->
        <Popup x:Name="WorkspacePopup"
               IsOpen="{Binding IsChecked, ElementName=WorkspaceToggleButton, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=WorkspaceToggleButton}"
               Placement="Top"
               VerticalOffset="-6"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">

            <Border Background="#1E1E24"
                    BorderBrush="#333742"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Width="260">
                <StackPanel>
                    <TextBlock Text="Arbeitsbereiche"
                               Foreground="#F3F4F6"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <TextBlock Text="Steuert die virtuellen Windows-Desktops"
                               Foreground="#9CA3AF"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />
                    <Button Content="◀ Vorheriger Desktop"
                            Click="PreviousDesktop_Click"
                            Style="{StaticResource TaskbarButtonStyle}" />
                    <Button Content="Nächster Desktop ▶"
                            Click="NextDesktop_Click"
                            Style="{StaticResource TaskbarButtonStyle}" />
                    <Button Content="＋ Neuer Desktop"
                            Click="AddDesktop_Click"
                            Style="{StaticResource TaskbarButtonStyle}"
                            Margin="2,8,2,0" />
                    <Separator Margin="4,10" />
                    <Button Content="Aktuellen Desktop schließen"
                            Click="CloseCurrentDesktop_Click"
                            Style="{StaticResource TaskbarButtonStyle}" />
                    <TextBlock x:Name="WorkspaceStatusTextBlock"
                               Foreground="#9CA3AF"
                               FontSize="10"
                               Margin="4,10,4,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
