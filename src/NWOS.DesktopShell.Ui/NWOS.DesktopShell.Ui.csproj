<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NWOS.DesktopShell.Ui</RootNamespace>
    <OutputType>WinExe</OutputType>
    <!--
      Die UI spricht mit Cardinal ausschließlich über NWOS.Ipc (Named Pipe).
      Sie referenziert bewusst NICHT mehr NWOS.DesktopShell / NWOS.Widgets:
      Icons, Boxen, Widgets und Suche liegen im laufenden Cardinal-Prozess
      (NWOS.Bootstrap.Windows), die UI ist nur noch Darstellung (Abschnitt 7).
    -->
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\CGUI\Bilder-NWOS\Master button\Button Logo.jpeg"
              Link="Assets\MasterButton\Button Logo.jpeg" />
    <Resource Include="..\..\CGUI\Bilder-NWOS\Master button\Flyout-Festung.jpeg"
              Link="Assets\MasterButton\Flyout-Festung.jpeg" />
    <Resource Include="..\..\CGUI\Bilder-NWOS\Master button\Master-Background.jpeg"
              Link="Assets\MasterButton\Master-Background.jpeg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NWOS.ConfigSetup\NWOS.ConfigSetup.csproj" />
    <ProjectReference Include="..\NWOS.Contracts\NWOS.Contracts.csproj" />
    <ProjectReference Include="..\NWOS.Ipc\NWOS.Ipc.csproj" />
    <ProjectReference Include="..\NWOS.DesktopShell\NWOS.DesktopShell.csproj" />
    <ProjectReference Include="..\NWOS.Core\NWOS.Core.csproj" />
  </ItemGroup>

</Project>