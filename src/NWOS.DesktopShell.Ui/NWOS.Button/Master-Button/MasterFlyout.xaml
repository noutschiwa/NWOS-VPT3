<UserControl x:Class="NWOS.DesktopShell.Ui.Button.MasterFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="45" d:DesignWidth="45">

    <Grid x:Name="MasterContainer">
        <!-- Taskleisten-Button -->
        <ToggleButton x:Name="MasterToggleButton"
                      Content="☰"
                      Width="36" Height="36"
                      Background="Transparent"
                      Foreground="#F3F4F6"
                      BorderThickness="0"
                      Cursor="Hand" />

        <!-- Master-Menü Popup -->
        <Popup x:Name="MasterPopup"
               IsOpen="{Binding IsChecked, ElementName=MasterToggleButton, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=MasterToggleButton}"
               Placement="Top"
               VerticalOffset="-6"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">

            <Border Background="#1E1E24"
                    BorderBrush="#333742"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Width="250">
                <!-- Deinen bestehenden Master-Inhalt (z. B. Systemaktionen, Energieoptionen) hier einfügen -->
                <StackPanel>
                    <TextBlock Text="NWOS Master-Menü"
                               Foreground="#F3F4F6"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <!-- Deine bestehenden Buttons / Listen -->
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>