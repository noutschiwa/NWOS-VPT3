<UserControl x:Class="NWOS.DesktopShell.Ui.Button.AudioFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="45" d:DesignWidth="45">

    <Grid x:Name="AudioContainer">
        <!-- Taskleisten-Button (klickbasiert) -->
        <ToggleButton x:Name="AudioToggleButton"
                      Content="🔊"
                      Width="36" Height="36"
                      Background="Transparent"
                      Foreground="#F3F4F6"
                      BorderThickness="0"
                      Cursor="Hand" />

        <!-- Audio-Flyout Popup (bleibt offen, bis außerhalb geklickt wird) -->
        <Popup x:Name="AudioPopup"
               IsOpen="{Binding IsChecked, ElementName=AudioToggleButton, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=AudioToggleButton}"
               Placement="Top"
               VerticalOffset="-6"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Opened="AudioPopup_Opened">

            <Border Background="#1E1E24"
                    BorderBrush="#333742"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Width="270">
                <StackPanel Orientation="Vertical">

                    <!-- 1. Systemlautstärke (mit Windows Core Audio verbunden) -->
                    <TextBlock Text="Systemlautstärke"
                               Foreground="#F3F4F6"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="38" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="MuteButton"
                                Grid.Column="0"
                                Content="🔊"
                                Width="28" Height="28"
                                Background="Transparent"
                                Foreground="#F3F4F6"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="MuteButton_Click" />

                        <Slider x:Name="VolumeSlider"
                                Grid.Column="1"
                                Minimum="0"
                                Maximum="100"
                                VerticalAlignment="Center"
                                Margin="8,0"
                                IsMoveToPointEnabled="True"
                                ValueChanged="VolumeSlider_ValueChanged" />

                        <TextBlock x:Name="VolumePercentText"
                                   Grid.Column="2"
                                   Text="50%"
                                   Foreground="#9CA3AF"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="#333742" Margin="0,0,0,10" />

                    <!-- 2. Gerätesteuerung (Mikro, Speaker, Cam) -->
                    <TextBlock Text="Gerätesteuerung"
                               Foreground="#9CA3AF"
                               FontSize="11"
                               Margin="0,0,0,6" />

                    <UniformGrid Columns="3" Height="30" Margin="0,0,0,10">
                        <Button Content="Mic"
                                Style="{StaticResource TaskbarButtonStyle}"
                                Background="#2D323E"
                                Foreground="White"
                                Margin="2"
                                Click="ToggleMic_Click" />
                        <Button Content="Spk"
                                Style="{StaticResource TaskbarButtonStyle}"
                                Background="#2D323E"
                                Foreground="White"
                                Margin="2"
                                Click="ToggleSpeaker_Click" />
                        <Button Content="Cam"
                                Style="{StaticResource TaskbarButtonStyle}"
                                Background="#2D323E"
                                Foreground="White"
                                Margin="2"
                                Click="ToggleCam_Click" />
                    </UniformGrid>

                    <Separator Background="#333742" Margin="0,0,0,10" />

                    <!-- 3. App-Lautstärke-Liste -->
                    <TextBlock Text="App-Lautstärke"
                                                   Foreground="#9CA3AF"
                                                   FontSize="11"
                                                   Margin="0,0,0,6" />
                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="AppAudioListPanel" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>