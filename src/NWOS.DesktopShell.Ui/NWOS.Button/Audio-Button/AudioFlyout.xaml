<UserControl x:Class="NWOS.DesktopShell.Ui.Button.AudioFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             x:Name="AudioContainer"
             MouseEnter="AudioContainer_MouseEnter"
             MouseLeave="AudioContainer_MouseLeave"
             d:DesignHeight="100" d:DesignWidth="100">
    <Grid>
        <!-- Der Audio-Button in der Taskleiste -->
        <Button x:Name="AudioButton" Content="Audio" Style="{StaticResource TaskbarButtonStyle}" Width="45" Height="36"/>

        <!-- Das hochfahrende vertikale Audio-Fenster -->
        <Popup x:Name="AudioPopup" PlacementTarget="{Binding ElementName=AudioButton}" Placement="Top" IsOpen="False" StaysOpen="True">
            <Border Background="#CC1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="10" Width="220">
                <StackPanel Orientation="Vertical">

                    <!-- Oberster Bereich: Geräteschalter (Mikro, Speaker, Cam) -->
                    <TextBlock Text="Gerätesteuerung" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,6"/>
                    <UniformGrid Columns="3" Height="30" Margin="0,0,0,10">
                        <Button Content="Mic" Style="{StaticResource TaskbarButtonStyle}" Background="#333333" Foreground="White" Margin="2" Click="ToggleMic_Click"/>
                        <Button Content="Spk" Style="{StaticResource TaskbarButtonStyle}" Background="#333333" Foreground="White" Margin="2" Click="ToggleSpeaker_Click"/>
                        <Button Content="Cam" Style="{StaticResource TaskbarButtonStyle}" Background="#333333" Foreground="White" Margin="2" Click="ToggleCam_Click"/>
                    </UniformGrid>

                    <Separator Background="#444444" Margin="0,0,0,10"/>

                    <!-- Mittlerer/Unteren Bereich: App-Lautstärke-Liste -->
                    <TextBlock Text="App-Lautstärke" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,6"/>

                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="AppAudioListPanel">
                            <!-- Beispiel-Eintrag für eine offene App -->
                            <Border Background="#2A2A2A" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="NWOS DesktopShell" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                    <Slider Minimum="0" Maximum="100" Value="80" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#2A2A2A" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="Alice Assistant" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                    <Slider Minimum="0" Maximum="100" Value="60" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>