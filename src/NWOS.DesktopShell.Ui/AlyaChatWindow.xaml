<Window x:Class="NWOS.DesktopShell.Ui.AlyaChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NWOS CAI"
        Width="900"
        Height="620"
        MinWidth="680"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="#111827"
        Foreground="#E5E7EB">
    <Border Margin="12"
            Background="#E6192335"
            BorderBrush="#806AADE4"
            BorderThickness="1"
            CornerRadius="14">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="4,0,4,12">
                <TextBlock Text="CAI  /  NWOS AI"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#EAF5FF" />
                <TextBlock x:Name="MemoryStatusText"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Foreground="#9CA3AF"
                           FontSize="11"
                           Text="Gesprächsprotokoll wird lokal gespeichert" />
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <Button x:Name="AlyaModeButton"
                            Content="Alya"
                            Click="AlyaModeButton_Click"
                            Margin="0,0,0,8"
                            Padding="12,10"
                            Background="#164F70"
                            Foreground="White"
                            BorderBrush="#38BDF8" />
                    <Button x:Name="MarcModeButton"
                            Content="Marc"
                            Click="MarcModeButton_Click"
                            Margin="0,0,0,8"
                            Padding="12,10"
                            Background="#202938"
                            Foreground="#E5E7EB"
                            BorderBrush="#3B4658" />
                    <Button x:Name="AlyaMarcModeButton"
                            Content="Alya-Marc"
                            Click="AlyaMarcModeButton_Click"
                            Margin="0,0,0,8"
                            Padding="12,10"
                            Background="#202938"
                            Foreground="#E5E7EB"
                            BorderBrush="#3B4658" />
                    <Separator Margin="0,8" />
                    <Button x:Name="SystemCheckButton"
                            Content="Alice: Systemcheck"
                            Click="SystemCheckButton_Click"
                            Padding="8"
                            Background="#202938"
                            Foreground="#C5D5E8"
                            BorderBrush="#3B4658"
                            ToolTip="Lesender Diagnosebericht; keine Systemänderungen" />
                    <TextBlock Margin="2,12,2,0"
                               Text="Gesprächsnotizen und letzte Nachrichten bleiben lokal gespeichert. KI-Eingaben und Kontext werden an den konfigurierten Anbieter gesendet."
                               Foreground="#9CA3AF"
                               FontSize="10"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#0D1017"
                        BorderBrush="#2E3A52"
                        BorderThickness="1"
                        CornerRadius="8">
                    <ScrollViewer x:Name="ConversationScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="12">
                        <ItemsControl x:Name="ConversationItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="10,8"
                                            Background="#181E2A"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Speaker}"
                                                       Foreground="#60A5FA"
                                                       FontWeight="SemiBold"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding Content}"
                                                       Margin="0,4,0,0"
                                                       Foreground="#E5E7EB"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="157,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ChatInputTextBox"
                         MinHeight="44"
                         MaxHeight="110"
                         Padding="10,8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="#1A2434"
                         Foreground="#F3F4F6"
                         CaretBrush="#38BDF8"
                         BorderBrush="#50627B"
                         KeyDown="ChatInputTextBox_KeyDown" />
                <Button Grid.Column="1"
                        Content="Senden"
                        Click="SendButton_Click"
                        Margin="8,0,0,0"
                        Padding="18,8"
                        Background="#164F70"
                        Foreground="White"
                        BorderBrush="#38BDF8" />
            </Grid>
        </Grid>
    </Border>
</Window>
