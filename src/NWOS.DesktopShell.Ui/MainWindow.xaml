<Window x:Class="NWOS.DesktopShell.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:btn="clr-namespace:NWOS.DesktopShell.Ui.Button"
        Title="NWOS System Shell"
        Height="45"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#1E1E1E"
        Topmost="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- 1. Dunkles ContextMenu-Container-Styling -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#1E1E24" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#333742" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. Dunkles MenuItem-Styling mit Hover-Effekt -->
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2D323E" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6B7280" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. Dezenter Trennstrich (Separator) -->
        <Style TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Background" Value="#333742" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 4. Dunkles Styling für den WPF-Calendar im Uhrzeit-Flyout -->
        <Style TargetType="Calendar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="CalendarDayButton">
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="11" />
            <Style.Triggers>
                <Trigger Property="IsToday" Value="True">
                    <Setter Property="Background" Value="#0284C7" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#38BDF8" />
                    <Setter Property="Foreground" Value="#0F172A" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Trigger>
                <Trigger Property="IsInactive" Value="True">
                    <Setter Property="Foreground" Value="#6B7280" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CalendarButton">
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Resources>

    <!-- EINZIGES ROOT-ELEMENT FÜR DAS FENSTER -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ZONE 1: Widgets & Alya -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
            <Button x:Name="AlyaButton" Content="🤖 Alya" Click="AlyaButton_Click" Style="{StaticResource TaskbarButtonStyle}"/>
            <ItemsControl x:Name="WidgetsItemsControl" ItemsSource="{Binding Zone1ViewModel.Widgets}" Visibility="Collapsed"/>
            <ComboBox x:Name="WidgetTypeComboBox" Width="0" Height="0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- ZONE 2: Navigation, WS1 & Alice-Suche -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0" VerticalAlignment="Center">
            <btn:WorkspaceFlyout Margin="2,0"/>

            <Grid Margin="6,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding Zone2ViewModel.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Width="150"
                             Height="28"
                             Padding="8,4"
                             Background="#262932"
                             Foreground="#F3F4F6"
                             CaretBrush="#38BDF8"
                             BorderBrush="#333742"
                             BorderThickness="1"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"
                             GotFocus="SearchBox_GotFocus"
                             PreviewKeyDown="SearchBox_PreviewKeyDown" />

                    <Button x:Name="AliceSearchButton"
                            Content="🔍 Alice"
                            Click="AliceSearchButton_Click"
                            Style="{StaticResource TaskbarButtonStyle}"
                             ToolTip="Alice-Suche; ohne Suchbegriff startet Alice einen manuellen Sicherheits-Scan"
                            Margin="4,0,0,0" />
                </StackPanel>

                <!-- Dunkles Suchergebnis-Dropdown -->
                <Popup x:Name="SearchResultsPopup"
                       PlacementTarget="{Binding ElementName=SearchBox}"
                       Placement="Top"
                       VerticalOffset="-6"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">

                    <Border Background="#1E1E24"
                            BorderBrush="#333742"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10"
                            Width="320"
                            MaxHeight="340">
                        <StackPanel>
                            <TextBlock x:Name="SearchStatusTextBlock"
                                       Text="Schnellsuche &amp; Alice"
                                       Foreground="#9CA3AF"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="4,0,4,8" />

                            <!-- Antwort-Box für direkte Alice-Rückmeldungen per Cardinal-IPC -->
                                                        <Border x:Name="AliceResponseBorder"
                                                                Visibility="Collapsed"
                                                                Background="#182232"
                                                                BorderBrush="#0284C7"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="10"
                                                                Margin="0,0,0,8">
                                                            <StackPanel>
                                                                <TextBlock Text="🔍 Alice"
                                                                           Foreground="#38BDF8"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Margin="0,0,0,4" />
                                                                <TextBlock x:Name="AliceResponseTextBlock"
                                                                           Text=""
                                                                           Foreground="#F3F4F6"
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap" />

                                                                <ItemsControl x:Name="AliceActionButtonsControl"
                                                                              Margin="0,8,0,0">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel Orientation="Horizontal" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Content="{Binding Label}"
                                                                                    Tag="{Binding}"
                                                                                    Click="AliceActionButton_Click"
                                                                                    Background="#2563EB"
                                                                                    Foreground="#FFFFFF"
                                                                                    BorderThickness="0"
                                                                                    Padding="8,4"
                                                                                    Margin="0,0,6,4"
                                                                                    FontSize="11"
                                                                                    FontWeight="SemiBold"
                                                                                    Cursor="Hand" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>

                                                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                                            <ItemsControl x:Name="SearchResultsItemsControl">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Tag="{Binding}"
                                                                                Click="SearchResultItem_Click"
                                                                                HorizontalContentAlignment="Stretch"
                                                                                Background="Transparent"
                                                                                BorderThickness="0"
                                                                                Padding="8,6"
                                                                                Margin="0,0,0,2"
                                                                                Cursor="Hand">
                                                                            <Button.ContextMenu>
                                                                                <ContextMenu>
                                                                                    <MenuItem Header="📌 An App-Hub anheften"
                                                                                              Tag="{Binding}"
                                                                                              Click="PinSearchResultToAppHub_Click" />
                                                                                </ContextMenu>
                                                                            </Button.ContextMenu>
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="24" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>

                                                                                <Grid Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                                    <Image Source="{Binding IconImage}"
                                                                                           Width="16"
                                                                                           Height="16"
                                                                                           SnapsToDevicePixels="True"
                                                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                                                        <Image.Style>
                                                                                            <Style TargetType="Image">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Image.Style>
                                                                                    </Image>

                                                                                    <TextBlock Text="{Binding Icon}"
                                                                                               FontSize="13"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock">
                                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                </Grid>

                                                                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding Title}"
                                                                                               Foreground="#F3F4F6"
                                                                                               FontSize="12"
                                                                                               FontWeight="SemiBold"
                                                                                               TextTrimming="CharacterEllipsis" />
                                                                                    <TextBlock Text="{Binding Subtitle}"
                                                                                               Foreground="#9CA3AF"
                                                                                               FontSize="10"
                                                                                               TextTrimming="CharacterEllipsis" />
                                                                                </StackPanel>

                                                                                <TextBlock Grid.Column="2"
                                                                                           Text="{Binding Category}"
                                                                                           Foreground="#60A5FA"
                                                                                           FontSize="10"
                                                                                           VerticalAlignment="Center"
                                                                                           Margin="8,0,0,0" />
                                                                            </Grid>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
            </Grid>
        </StackPanel>

        <!-- ZONE 3: App-Hub, auf beide Seiten des mittigen App-Buttons verteilt -->
        <Grid Grid.Column="2" VerticalAlignment="Center" Background="Transparent" AllowDrop="True" Drop="AppHub_Drop">
            <ItemsControl x:Name="AppHubLeftItemsControl" VerticalAlignment="Center" HorizontalAlignment="Right">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button ToolTip="{Binding FullName}"
                                Style="{StaticResource TaskbarButtonStyle}"
                                Width="36" Height="36" Margin="2,0"
                                AllowDrop="True"
                                PreviewMouseLeftButtonDown="AppIcon_PreviewMouseLeftButtonDown"
                                MouseMove="AppIcon_MouseMove"
                                Drop="AppHub_Drop"
                                Click="AppIconButton_Click">
                            <Grid Width="32" Height="32">
                                <!-- Echtes Programm-Icon (20x20 Pixel) -->
                                <Image Source="{Binding IconImage}"
                                       Width="20" Height="20"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <!-- Fallback-Textkürzel -->
                                <TextBlock Text="{Binding Name}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Aktiver Indikator-Balken für laufende Programme -->
                                <Border Height="3"
                                        Width="14"
                                        CornerRadius="1.5"
                                        Background="#38BDF8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>

                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Neues Fenster öffnen"
                                              Click="OpenNewInstance_Click" />
                                    <MenuItem Header="Beenden"
                                              Click="CloseApp_Click">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Aus App-Hub entfernen"
                                              Click="RemoveAppIcon_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Grid Grid.Column="3" VerticalAlignment="Center">
            <btn:MasterFlyout x:Name="CenterMasterFlyout" />
        </Grid>

        <Grid Grid.Column="4" VerticalAlignment="Center" Background="Transparent" AllowDrop="True" Drop="AppHub_Drop">
            <ItemsControl x:Name="AppHubRightItemsControl" VerticalAlignment="Center" HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button ToolTip="{Binding FullName}"
                                Style="{StaticResource TaskbarButtonStyle}"
                                Width="36" Height="36" Margin="2,0"
                                AllowDrop="True"
                                PreviewMouseLeftButtonDown="AppIcon_PreviewMouseLeftButtonDown"
                                MouseMove="AppIcon_MouseMove"
                                Drop="AppHub_Drop"
                                Click="AppIconButton_Click">
                            <Grid Width="32" Height="32">
                                <Image Source="{Binding IconImage}" Width="20" Height="20"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock Text="{Binding Name}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Height="3" Width="14" CornerRadius="1.5"
                                        Background="#38BDF8" HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom" Margin="0,0,0,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Neues Fenster öffnen" Click="OpenNewInstance_Click" />
                                    <MenuItem Header="Beenden" Click="CloseApp_Click">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Aus App-Hub entfernen" Click="RemoveAppIcon_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- ZONE 4: Audio & System Monitor -->
        <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
            <btn:AudioFlyout Margin="2,0"/>
            <Button Content="📊 Monitor" Click="MonitorButton_Click" Style="{StaticResource TaskbarButtonStyle}"/>
        </StackPanel>

        <!-- ZONE 5: Benachrichtigungs-Feed & Systemuhr mit Kalender-Flyout -->
        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,12,0" VerticalAlignment="Center">
            <btn:InfoFlyout Margin="2,0"/>

            <Grid Margin="10,0,0,0">
                <!-- Klickbare Uhrzeit als ToggleButton -->
                <ToggleButton x:Name="ClockToggleButton"
                              Padding="8,2"
                              Height="36"
                              Background="Transparent"
                              BorderThickness="0"
                              Cursor="Hand"
                              ToolTip="{Binding ElementName=DateTextBlock, Path=Tag}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TimeTextBlock"
                                   Text="00:00"
                                   Foreground="#F3F4F6"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                        <TextBlock x:Name="DateTextBlock"
                                   Text="01.01.2026"
                                   Foreground="#9CA3AF"
                                   FontSize="10"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </ToggleButton>

                <!-- Dunkles Kalender-Popup -->
                <Popup x:Name="ClockPopup"
                       IsOpen="{Binding IsChecked, ElementName=ClockToggleButton, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=ClockToggleButton}"
                       Placement="Top"
                       VerticalOffset="-6"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       Opened="ClockPopup_Opened">

                    <Border Background="#1E1E24"
                            BorderBrush="#333742"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14"
                            Width="270">
                        <StackPanel>
                            <!-- Großes Live-Datum & Sekunden im Flyout-Kopf -->
                            <TextBlock x:Name="PopupClockTextBlock"
                                       Text="00:00:00"
                                       Foreground="#F3F4F6"
                                       FontSize="22"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="PopupFullDateTextBlock"
                                       Text="Freitag, 20. November 2026"
                                       Foreground="#38BDF8"
                                       FontSize="12"
                                       Margin="0,2,0,10" />

                            <Separator Background="#333742" Margin="0,0,0,8" />

                            <!-- Monatskalender -->
                            <Calendar x:Name="TaskbarCalendar"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Foreground="#F3F4F6"
                                      HorizontalAlignment="Center" />

                            <!-- "Heute"-Schnellbutton -->
                            <Button Content="Heute auswählen"
                                    Margin="0,8,0,0"
                                    Padding="8,5"
                                    Background="#2D323E"
                                    Foreground="#F3F4F6"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="JumpToToday_Click" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </StackPanel>
    </Grid>
</Window>