<Window x:Class="NWOS.DesktopShell.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NWOS System Shell"
        Height="45"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#1E1E1E"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ZONE 1: Widgets & Alya -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0">
            <Button Content="🤖 Alya" Click="AlyaButton_Click" Style="{StaticResource TaskbarButtonStyle}"/>
            <ItemsControl x:Name="WidgetsItemsControl" ItemsSource="{Binding Zone1ViewModel.Widgets}" Visibility="Collapsed"/>
            <ComboBox x:Name="WidgetTypeComboBox" Width="0" Height="0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- ZONE 2: Navigation, Master-Button & Alice-Suche -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0">
            <Button Content="❖ Master" Click="MasterButton_Click" Style="{StaticResource TaskbarButtonStyle}"/>
            <Button Content="🖥️ WS1" Click="WorkspaceButton_Click" Style="{StaticResource TaskbarButtonStyle}"/>
            <TextBox x:Name="SearchBox" Text="{Binding Zone2ViewModel.SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="120" VerticalAlignment="Center" Margin="6,0"/>
            <Button Content="🔍 Alice" Click="AlyaButton_Click" Style="{StaticResource TaskbarButtonStyle}"/>
            <ListBox x:Name="SearchResultsList" Width="0" Height="0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- ZONE 3: App-Hub (Zentrum mit Drag & Drop) -->
        <Grid Grid.Column="2">
            <ItemsControl x:Name="AppHubItemsControl" AllowDrop="True" Drop="AppHub_Drop" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Name}"
                                Style="{StaticResource TaskbarButtonStyle}"
                                Width="36" Height="36" Margin="2,0"
                                AllowDrop="True"
                                PreviewMouseLeftButtonDown="AppIcon_PreviewMouseLeftButtonDown"
                                MouseMove="AppIcon_MouseMove"
                                Drop="AppHub_Drop"
                                Click="AppIconButton_Click" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl x:Name="BoxesItemsControl" Visibility="Collapsed"/>
        </Grid>

        <!-- ZONE 4: Audio & System Monitor -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0">
            <Button Content="🔊 Audio" Click="AudioButton_Click" Style="{StaticResource TaskbarButtonStyle}"/>
            <Button Content="📊 Monitor" Click="MonitorButton_Click" Style="{StaticResource TaskbarButtonStyle}"/>
        </StackPanel>

        <!-- ZONE 5: Benachrichtigungs-Feed -->
        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0">
            <Button Content="🔔 Info" Click="InfoButton_Click" Style="{StaticResource TaskbarButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>