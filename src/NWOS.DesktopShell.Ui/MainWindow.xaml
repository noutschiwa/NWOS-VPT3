<Window x:Class="NWOS.DesktopShell.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:btn="clr-namespace:NWOS.DesktopShell.Ui.Button"
        Title="NWOS System Shell"
        Height="45"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#1E1E1E"
        Topmost="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- 1. Dunkles ContextMenu-Container-Styling -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#1E1E24" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#333742" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. Dunkles MenuItem-Styling mit Hover-Effekt -->
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2D323E" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6B7280" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. Dezenter Trennstrich (Separator) -->
        <Style TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Background" Value="#333742" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- EINZIGES ROOT-ELEMENT FÜR DAS FENSTER -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ZONE 1: Widgets & Alya -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
            <Button Content="🤖 Alya" Click="AlyaButton_Click" Style="{StaticResource TaskbarButtonStyle}"/>
            <ItemsControl x:Name="WidgetsItemsControl" ItemsSource="{Binding Zone1ViewModel.Widgets}" Visibility="Collapsed"/>
            <ComboBox x:Name="WidgetTypeComboBox" Width="0" Height="0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- ZONE 2: Navigation, Master-Button, WS1 & Alice-Suche -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
            <btn:MasterFlyout Margin="2,0"/>
            <btn:WorkspaceFlyout Margin="2,0"/>
            <TextBox x:Name="SearchBox" Text="{Binding Zone2ViewModel.SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="120" VerticalAlignment="Center" Margin="6,0"/>
            <Button Content="🔍 Alice" Click="AlyaButton_Click" Style="{StaticResource TaskbarButtonStyle}"/>
            <ListBox x:Name="SearchResultsList" Width="0" Height="0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- ZONE 3: App-Hub (Zentrum mit Drag & Drop) -->
        <Grid Grid.Column="2" VerticalAlignment="Center" Background="Transparent" AllowDrop="True" Drop="AppHub_Drop">
            <ItemsControl x:Name="AppHubItemsControl" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button ToolTip="{Binding FullName}"
                                Style="{StaticResource TaskbarButtonStyle}"
                                Width="36" Height="36" Margin="2,0"
                                AllowDrop="True"
                                PreviewMouseLeftButtonDown="AppIcon_PreviewMouseLeftButtonDown"
                                MouseMove="AppIcon_MouseMove"
                                Drop="AppHub_Drop"
                                Click="AppIconButton_Click">
                            <Grid Width="32" Height="32">
                                <!-- Echtes Programm-Icon (20x20 Pixel) -->
                                <Image Source="{Binding IconImage}"
                                       Width="20" Height="20"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <!-- Fallback-Textkürzel -->
                                <TextBlock Text="{Binding Name}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Aktiver Indikator-Balken für laufende Programme -->
                                <Border Height="3"
                                        Width="14"
                                        CornerRadius="1.5"
                                        Background="#38BDF8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>

                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Neues Fenster öffnen"
                                              Click="OpenNewInstance_Click" />
                                    <MenuItem Header="Beenden"
                                              Click="CloseApp_Click">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Aus App-Hub entfernen"
                                              Click="RemoveAppIcon_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl x:Name="BoxesItemsControl" Visibility="Collapsed"/>
        </Grid>

        <!-- ZONE 4: Audio & System Monitor -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
            <btn:AudioFlyout Margin="2,0"/>
            <Button Content="📊 Monitor" Click="MonitorButton_Click" Style="{StaticResource TaskbarButtonStyle}"/>
        </StackPanel>

        <!-- ZONE 5: Benachrichtigungs-Feed -->
        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
            <btn:InfoFlyout Margin="2,0"/>
        </StackPanel>
    </Grid>
</Window>