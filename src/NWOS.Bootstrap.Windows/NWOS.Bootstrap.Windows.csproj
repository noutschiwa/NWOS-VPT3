<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NWOS.Bootstrap.Windows</RootNamespace>
    <OutputType>Exe</OutputType>
    <PublishAot>false</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The bootstrap loads the executable NWOS.Host project through composition.
         Preserve project-reference runtime assets in the installed deps manifest. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!--
      Das ist der einzige Einstiegspunkt, der tatsächlich alle Windows-
      spezifischen Fähigkeiten von NWOS zusammenführt: WMI-Systemstatus,
      Registry-Autostart-Verwaltung und (nur auf explizite Anforderung,
      niemals automatisch - Abschnitt 41) die Shell-Registrierung.
      NWOS.Host bleibt bewusst plattformneutral und wird hier nur als
      Komposition wiederverwendet (siehe NWOS.Host.HostComposition).
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NWOS.Host\NWOS.Host.csproj" />
    <ProjectReference Include="..\NWOS.SystemCenter.Windows\NWOS.SystemCenter.Windows.csproj" />
    <ProjectReference Include="..\NWOS.WindowsIntegration\NWOS.WindowsIntegration.csproj" />
    <ProjectReference Include="..\NWOS.Core\NWOS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\CGUI\Bilder-NWOS\Hintergrund-Wasserzeichen\NWOS-Logo-Standart Hintergund.png">
      <Link>Bilder-NWOS\Hintergrund-Wasserzeichen\NWOS-Logo-Standart Hintergund.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
