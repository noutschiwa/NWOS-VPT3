<UserControl x:Class="NWOS.DesktopShell.Ui.NwosSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="280"
             Foreground="#F3F4F6">
    <Grid Background="#F0192434">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="16,14,16,10">
            <Button Content="Zurück"
                    DockPanel.Dock="Right"
                    Padding="9,5"
                    Click="Back_Click" />
            <StackPanel>
                <TextBlock Text="NWOS-Einstellungen"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#EAF5FF" />
                <TextBlock Text="Konfiguriere NWOS direkt im Startmenü."
                           Margin="0,3,0,0"
                           FontSize="11"
                           Foreground="#AABBD0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="12,0,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Button x:Name="GeneralCategoryButton"
                        Content="Allgemein"
                        HorizontalContentAlignment="Left"
                        Padding="10,9"
                        Margin="0,0,6,6"
                        Click="GeneralCategory_Click" />
                <Button x:Name="DesignCategoryButton"
                        Content="Design"
                        HorizontalContentAlignment="Left"
                        Padding="10,9"
                        Margin="0,0,6,6"
                        Click="DesignCategory_Click" />
            </StackPanel>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel x:Name="GeneralSettingsPage">
                        <TextBlock Text="Allgemein"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#7DD3FC"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="Module"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#D5E8FA"
                                   Margin="0,0,0,5" />
                        <CheckBox x:Name="DesktopShellCheckBox" Content="Desktop-Shell" Margin="0,5" />
                        <CheckBox x:Name="WidgetsCheckBox" Content="Widgets" Margin="0,5" />
                        <CheckBox x:Name="AliceCheckBox" Content="Alice-Sicherheit (empfohlen)" Margin="0,5" />
                        <CheckBox x:Name="MarcCheckBox" Content="Marc" Margin="0,5" />
                        <CheckBox x:Name="AlyaCheckBox" Content="Alya" Margin="0,5" />
                        <CheckBox x:Name="SystemCenterCheckBox" Content="System Center" Margin="0,5" />
                        <TextBlock Text="Moduländerungen werden beim nächsten Start von NWOS übernommen."
                                   TextWrapping="Wrap"
                                   Foreground="#9CA3AF"
                                   FontSize="11"
                                   Margin="0,12,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="DesignSettingsPage" Visibility="Collapsed">
                        <TextBlock Text="Design"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#7DD3FC"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="Akzentfarbe"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#D5E8FA"
                                   Margin="0,0,0,5" />
                        <ComboBox x:Name="AccentComboBox"
                                  SelectedValuePath="Tag"
                                  Padding="7,5"
                                  Background="#1B2230"
                                  Foreground="#1F2937">
                            <ComboBoxItem Content="Blau" Tag="Blue" />
                            <ComboBoxItem Content="Violett" Tag="Violet" />
                            <ComboBoxItem Content="Grün" Tag="Green" />
                        </ComboBox>
                        <CheckBox x:Name="FlyoutBackgroundCheckBox"
                                  Content="Master-Flyout-Hintergrund anzeigen"
                                  Margin="0,14,0,0" />
                        <TextBlock Text="Die Designoptionen werden sofort im Master-Flyout sichtbar."
                                   TextWrapping="Wrap"
                                   Foreground="#9CA3AF"
                                   FontSize="11"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <DockPanel Grid.Row="2" Margin="14,0,14,14">
            <TextBlock x:Name="SaveStatusText"
                       VerticalAlignment="Center"
                       Foreground="#86EFAC"
                       FontSize="11"
                       TextWrapping="Wrap" />
            <Button x:Name="SaveButton"
                    Content="Speichern"
                    DockPanel.Dock="Right"
                    MinWidth="92"
                    Padding="12,7"
                    Click="Save_Click" />
        </DockPanel>
    </Grid>
</UserControl>
