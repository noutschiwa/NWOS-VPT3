<Window x:Class="NWOS.DesktopShell.Ui.NwosSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NWOS-Einstellungen"
        Width="390"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E24"
        Foreground="#F3F4F6">
    <StackPanel Margin="22">
        <TextBlock Text="NWOS-Module"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#7DD3FC"
                   Margin="0,0,0,14" />
        <CheckBox x:Name="DesktopShellCheckBox" Content="Desktop-Shell" Margin="0,5" />
        <CheckBox x:Name="WidgetsCheckBox" Content="Widgets" Margin="0,5" />
        <CheckBox x:Name="AliceCheckBox" Content="Alice-Sicherheit (empfohlen)" Margin="0,5" />
        <CheckBox x:Name="MarcCheckBox" Content="Marc" Margin="0,5" />
        <CheckBox x:Name="AlyaCheckBox" Content="Alya" Margin="0,5" />
        <CheckBox x:Name="SystemCenterCheckBox" Content="System Center" Margin="0,5" />
        <TextBlock Text="Änderungen werden beim nächsten Start von NWOS übernommen."
                   TextWrapping="Wrap"
                   Foreground="#9CA3AF"
                   FontSize="11"
                   Margin="0,12,0,14" />
        <DockPanel>
            <Button Content="Abbrechen"
                    DockPanel.Dock="Right"
                    IsCancel="True"
                    MinWidth="90"
                    Margin="8,0,0,0"
                    Padding="10,6" />
            <Button x:Name="SaveButton"
                    Content="Speichern"
                    IsDefault="True"
                    MinWidth="90"
                    Padding="10,6"
                    Click="Save_Click" />
        </DockPanel>
    </StackPanel>
</Window>
